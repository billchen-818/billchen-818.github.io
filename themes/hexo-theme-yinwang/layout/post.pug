
block content
  .inner
    if theme.post.title_h1
      h1= page.title
      div.post-meta
        time.time(datetime=date_xml(page.date))= date(page.date, 'YYYY-MM-DD')
        if theme.busuanzi && theme.busuanzi.enable
          span.meta-separator(aria-hidden="true") ·
          span.post-reading
            span 本文阅读
            strong#busuanzi_page_pv —
            span 次
      if theme.post.show_tags
        if page.tags.length
          ul.tags
            - page.tags.each(function(tag){
              li
                span #
                a(href= config.root + tag.path)= tag.name
            - });
      else 
        div.title-margin
    else
      h2= page.title
    != page.content
    if theme.post.backHome
      if theme.post.backHome_hr
        hr
      p(class=theme.post.backhome_right ? "textAlignRight" : "")
        - var prefix = theme.post.backHome_prefix
        - var suffix = theme.post.backHome_suffix
        span!= prefix 
        a(href=config.root)= theme.post.backHome_content
        span!= suffix
