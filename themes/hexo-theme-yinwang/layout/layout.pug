- var pageTitle = page.title ? page.title + ' | ' + config.title : config.title || ''
- var root = config.root
- var rawDescription = page.description || page.excerpt || config.description || ''
- var pageDescription = strip_html(rawDescription).replace(/\s+/g, ' ').trim().slice(0, 160)
- var canonicalPath = (page.path || '').replace(/(^|\/)index\.html$/, '$1')
- var canonicalUrl = full_url_for(canonicalPath)

doctype html
html(lang=config.language)
  head
    title= pageTitle
    meta(http-equiv="content-type", content="text/html; charset=utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="description", content=pageDescription)
    meta(name="author", content=config.author)
    link(rel="canonical", href=canonicalUrl)
    meta(property="og:title", content=pageTitle)
    meta(property="og:description", content=pageDescription)
    meta(property="og:type", content=is_post() ? "article" : "website")
    meta(property="og:url", content=canonicalUrl)
    meta(property="og:site_name", content=config.title)
    meta(name="twitter:card", content="summary")
    link(rel="alternate", type="application/atom+xml", title=config.title, href=full_url_for('atom.xml'))
    
    link(rel='icon' type='image/svg+xml' href=root+'favicon.svg')
    link(rel="manifest" href=root+'site.webmanifest')
    
    link(rel='stylesheet', href=root+"css/highlight/xcode.min.css")
    link(rel='stylesheet', href=root+"css/bootstrap/bootstrap-tooltips.css")

    link(rel='stylesheet', href=root+"css/bootstrap/bootstrap.min.css")
    link(rel='stylesheet', href=root+"css/bootstrap/bootstrap-theme.min.css")
    link(rel='stylesheet', href=root+"css/home.css")
    unless is_home() || page.type=='micro-blog' || page.type=='404'
      link(rel='stylesheet', href=root+"css/post.css")

    script(src=root+"js/jquery.min.js")

  body
    nav.navbar.navbar-default(style={opacity:".9"}, role="navigation", aria-label="主导航")
      div.container-fluid
        div.navbar-header
          button.navbar-toggle.collapsed(type="button", data-toggle="collapse", data-target="#navbar-bs", aria-expanded="false", aria-controls="navbar-bs", aria-label="展开导航")
            span.icon-bar
            span.icon-bar
            span.icon-bar
          a.navbar-brand(
            href=root,
            title=config.title_tooltip,
            data-toggle="tooltip",
            data-placement="right"
            )= config.subtitle
        div.navbar-collapse.collapse#navbar-bs
          ul.nav.navbar-nav.navbar-right
            each url, label in theme.menu
              - var href = url.startsWith('http') ? url : root + url
              - var isActive = (url == '' && is_home()) || (url && page.path && page.path.startsWith(url))
              li(class=isActive ? 'active' : '')
                a(href=href, target=theme.header.blank ? "_blank" : "_self")= label
    
    if body
      div!= body
    else
      block content

    if theme.footer.display || (theme.busuanzi && theme.busuanzi.enable)
      footer.site-footer
        if theme.busuanzi && theme.busuanzi.enable
          div.site-statistics(aria-label="站点访问统计", aria-live="polite")
            span.statistic-item
              span.statistic-label 今日访客
              strong#busuanzi_today_uv.statistic-value —
            span.statistic-item
              span.statistic-label 今日浏览
              strong#busuanzi_today_pv.statistic-value —
            span.statistic-item
              span.statistic-label 累计访客
              strong#busuanzi_site_uv.statistic-value —
            span.statistic-item
              span.statistic-label 累计浏览
              strong#busuanzi_site_pv.statistic-value —
        if theme.footer.display
          if theme.footer.href
            p.site-copyright
              a(href=theme.footer.href)= theme.footer.text
          else
            p.site-copyright= theme.footer.text
  
    script(src=root+"js/highlight.min.js")
    script(src=root+"js/main.js")
    script(src=root+"js/bootstrap/bootstrap.min.js")

    if page.type=='micro-blog'
      script(src=root+"js/micro-blog/main.js")
      script(src=root+"js/marked.min.js")

    if theme.busuanzi && theme.busuanzi.enable
      script(src=theme.busuanzi.script, defer=true)

    if theme.google_analysis.enable && theme.google_analysis.id
      script(async="" src="https://www.googletagmanager.com/gtag/js?id="+theme.google_analysis.id)
      script.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '#{theme.google_analysis.id}');
